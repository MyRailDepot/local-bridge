{
  "name": "@myraildepot/local-bridge",
  "version": "0.1.3",
  "description": "Local bridge for MyRailDepot — runs on your machine, talks to your DCC command station and to the cloud.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MyRailDepot/local-bridge.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "private": false,
  "files": [
    "dist",
    "assets"
  ],
  "packageManager": "pnpm@9.0.0",
  "main": "dist/main.js",
  "bin": {
    "local-bridge": "dist/main.js"
  },
  "scripts": {
    "dev": "nest start --watch",
    "dev:demo": "DEMO_MODE=true nest start --watch",
    "start": "node dist/main.js",
    "build": "nest build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test 'src/**/*.spec.ts'",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/platform-ws": "^11.2.3",
    "@nestjs/websockets": "^11.2.3",
    "jsonwebtoken": "^9.0.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ws": "^8.21.3",
    "z21-client": "^2.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.4.1",
    "@types/ws": "^8.18.1",
    "eslint": "^10.10.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0"
  }
}